        ],
        "text_sha256": "3d52eba25963a1f289aa546cc0b3db9ac5c3c3690ad27cc9990684f5ab00cfea",
        "text_head": "第十四条 启动一级响应时,全体应急人员应在60分钟内到达指定集结地点。",
        "estimated_tokens": 32
      },
