        ],
        "text_sha256": "2e4084c3610204c9b0f8ace0cd5e8d38df5a13d060d861630d9aa106bc880a91",
        "text_head": "第二条 本预案适用于机场及其驻场单位发生的各类突发事件的应急处置工作。",
        "estimated_tokens": 35
      },
      {
        "locator_kind": "docx_paragraph",
        "locator_label": "第一章 总则 > 段落 4",
