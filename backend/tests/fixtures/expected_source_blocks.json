        "heading_path": [
          "第一章 总则"
        ],
        "text_sha256": "c4b479d39ddbccc00463a4514683f7106f3017cf863d2136e9ec6121cb084360",
        "text_head": "第三条 应急处置工作坚持生命至上、安全第一、预防为主、快速反应的原则。",
        "estimated_tokens": 35
      },
      {
        "locator_kind": "docx_paragraph",
        "locator_label": "第二章 组织机构与职责",
        "page_number": null,
        "heading_path": [
