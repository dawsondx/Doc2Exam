        ],
        "text_sha256": "dad3cf935dc8dcbfe7ec5d6a5f9b677a62d1c690c940f51744999fff6a2dc43a",
        "text_head": "第二章 组织机构与职责",
        "estimated_tokens": 11
      },
      {
        "locator_kind": "docx_paragraph",
        "locator_label": "第二章 组织机构与职责 > 段落 6",
        "page_number": null,
        "heading_path": [
          "第二章 组织机构与职责"
