        ],
        "text_sha256": "b52a38fb4f3540e3a518ae41b8b99525e9a03afd33cd089b0919731dd4063225",
        "text_head": "第十条 信息报告内容包括事件时间、地点、性质、影响范围、已采取措施和需要支援事项。",
        "estimated_tokens": 41
      },
      {
        "locator_kind": "docx_paragraph",
        "locator_label": "第三章 信息报告流程 > 段落 14",
